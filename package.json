{
  "name": "cuda-study-handbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "course:generate": "node scripts/generate-course-data.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run course:generate && vue-tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run course:generate && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.179.1",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/three": "^0.179.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
